#!/usr/bin/env bash
set -euo pipefail

APP_DIR="/opt/camrec-test"
DATA_DIR="/var/lib/camrec-test"
ARCHIVE_DIR="$DATA_DIR/archive"
LOG_DIR="/var/log/camrec-test"
SERVICE="/etc/systemd/system/camrec-test.service"
LAUNCHER="/usr/local/bin/camrec-test"
UNINSTALLER="/usr/local/bin/camrec-test-uninstall"

if [[ "${EUID}" -ne 0 ]]; then
  echo "Запусти так:"
  echo "  sudo ./CamRecTestArchInstaller.run"
  exit 1
fi

echo "=== CamRec Test for Arch Linux ==="

pacman -S --needed --noconfirm python tk ffmpeg v4l-utils coreutils

if ! getent group camrectest >/dev/null 2>&1; then
  groupadd --system camrectest
fi

if ! id camrectest >/dev/null 2>&1; then
  useradd --system --gid camrectest --home-dir /nonexistent --shell /usr/bin/nologin camrectest
fi

getent group video >/dev/null 2>&1 && usermod -a -G video camrectest || true

mkdir -p "$APP_DIR" "$ARCHIVE_DIR" "$LOG_DIR"

decode() {
  local target="$1" mode="$2" data="$3"
  printf '%s' "$data" | base64 -d > "$target"
  chmod "$mode" "$target"
}

decode "$APP_DIR/cam_daemon.py" 0755 "...TRUNCATED..." 

decode "$APP_DIR/cam_gui.py" 0755 "...TRUNCATED..."
decode "$SERVICE" 0644 ""

cat > "$DATA_DIR/settings.json" <<'JSON'
{
  "status": "stop",
  "source_type": "usb",
  "usb_device": "/dev/video0",
  "network_url": "",
  "resolution": "640x480",
  "framerate": 30,
  "retention_days": 2,
  "segment_minutes": 2
}
JSON

if [[ ! -f "$DATA_DIR/credentials.json" ]]; then
  cat > "$DATA_DIR/credentials.json" <<'JSON'
{
  "username": "",
  "password": ""
}
JSON
fi

chown -R camrectest:camrectest "$DATA_DIR" "$LOG_DIR"
chmod 2775 "$DATA_DIR" "$ARCHIVE_DIR" "$LOG_DIR"
chmod 0664 "$DATA_DIR/settings.json"
chmod 0660 "$DATA_DIR/credentials.json"

cat > "$LAUNCHER" <<'SH'
#!/usr/bin/env bash
exec /usr/bin/python3 /opt/camrec-test/cam_gui.py "$@"
SH
chmod 0755 "$LAUNCHER"

cat > "$UNINSTALLER" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${EUID}" -ne 0 ]]; then
  echo "sudo camrec-test-uninstall"
  exit 1
fi
systemctl disable --now camrec-test.service 2>/dev/null || true
rm -f /etc/systemd/system/camrec-test.service
systemctl daemon-reload
rm -rf /opt/camrec-test
rm -f /usr/local/bin/camrec-test /usr/local/bin/camrec-test-uninstall
echo "CamRec Test удалён. Архив оставлен в /var/lib/camrec-test"
SH
chmod 0755 "$UNINSTALLER"

DESKTOP_USER="${SUDO_USER:-}"
if [[ -n "$DESKTOP_USER" && "$DESKTOP_USER" != "root" ]]; then
  usermod -a -G camrectest "$DESKTOP_USER"
fi

systemctl daemon-reload
systemctl enable --now camrec-test.service

echo
echo "Готово."
echo "Запуск приложения:"
echo "  camrec-test"
echo
echo "Если GUI не сможет менять настройки — выйди из сеанса Linux и войди снова."
