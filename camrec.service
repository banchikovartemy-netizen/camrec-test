[Unit]
Description=CamRec video recorder
After=local-fs.target network-online.target sound.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=camrec
Group=camrec
ExecStart=/usr/bin/python3 /opt/camrec/camrec_daemon.py
Restart=always
RestartSec=3
RuntimeDirectory=camrec
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
